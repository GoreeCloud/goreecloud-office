{
  "$id": "urn:goreecloud:office:schema:package-relationships:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "relationships": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "id": {
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "internal",
              "embedded",
              "external"
            ]
          },
          "media_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "target",
          "kind"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "relationships"
  ],
  "title": "GoreeCloud Office Package Relationships v1",
  "type": "object"
}
